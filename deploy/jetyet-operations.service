[Unit]
Description=Jetyet Operations Worker
After=network-online.target jetyet-web.service
Wants=network-online.target jetyet-web.service

[Service]
Type=simple
User=jetyet
Group=jetyet
WorkingDirectory=/opt/jetyet
Environment=NODE_ENV=production
Environment=JETYET_CONFIG=/etc/jetyet/jetyet.config.json
ExecStart=/usr/local/bin/bun src/workers/operations.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=360
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jetyet /etc/jetyet

[Install]
WantedBy=multi-user.target
